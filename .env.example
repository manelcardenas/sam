# ===================================================================
# Recipe Manager - Environment Configuration
# ===================================================================

# -------------------------------------------------------------------
# API Configuration
# -------------------------------------------------------------------
PORT=9000
HOST=0.0.0.0

# -------------------------------------------------------------------
# DynamoDB Configuration (Local Development with Docker)
# -------------------------------------------------------------------
# Set USE_DYNAMODB=true when running with docker-compose
# This uses DynamoDB Local (docker service) instead of InMemory
USE_DYNAMODB=false

# DynamoDB Local endpoint (docker-compose service)
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_NAME=recipes

# AWS Credentials (values for local development)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=eu-west-3
