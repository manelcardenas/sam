# ===================================================================
# Recipe Manager - Environment Configuration
# ===================================================================

# -------------------------------------------------------------------
# API Configuration
# -------------------------------------------------------------------
PORT=9000
HOST=0.0.0.0

# -------------------------------------------------------------------
# PostgreSQL Configuration
#
# Preferred: a single DSN (Neon-friendly). If POSTGRES_DSN is set it
# takes precedence over the 5-field config below.
#   AWS (Lambda): injected by CDK from the SSM SecureString
#                 /recipe-manager/db/dsn
# -------------------------------------------------------------------
# POSTGRES_DSN=postgresql+psycopg2://user:pwd@ep-...-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Legacy 5-field config (still supported, matches docker-compose.yml for
# local Docker Postgres). Used only when POSTGRES_DSN is unset.
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_DB=recipe_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=

# -------------------------------------------------------------------
# Cognito (Authentication)
# -------------------------------------------------------------------
COGNITO_USER_POOL_ID=cognito-user-pool-id-placeholder
COGNITO_CLIENT_ID=cognito-client-id-placeholder

# -------------------------------------------------------------------
# CORS (local dev only)
#
# Prod CORS is handled by API Gateway, so leave this UNSET on Lambda.
# Locally, set it so the dev frontend (http://localhost:8080) can call
# uvicorn directly. Comma-separated for multiple origins.
# -------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8080

# -------------------------------------------------------------------
# Rate limiting (per client IP, per process)
#
# Safety guard. Caps requests per IP per minute; /health is exempt. State is
# in-memory per process, so it's effective for a single instance (local
# uvicorn) — on Lambda, API Gateway throttling is the real guard. Optional:
# defaults to 120 if unset; set to 0 to disable entirely.
# -------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120


GEOAPIFY_API_KEY=geoapify-api-key-placeholder

# --- Ingredient parsing (docs/plans/ingredient-capture-plan.md §7) -----------
# Named after the vendor, like GEOAPIFY_API_KEY above — one convention in this
# file, not two. The port/adapter stays provider-agnostic either way (plan §7.2);
# only the one-line resolver names the variable, so swapping vendors is an edit
# here plus one line of code, not a redesign.
#
# Same resolution order as every other secret: a raw key locally, an SSM
# SecureString *parameter name* on Lambda. Nothing reads these until Phase D.
#
#   aws ssm put-parameter --name /recipe-manager/llm/primary/api-key \
#     --value 'sk-...' --type SecureString --region eu-west-3
DEEPSEEK_API_KEY=deepseek-api-key-placeholder
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_MODEL=deepseek-chat

# The fallback is unnamed until it is chosen — an empty KIMI_API_KEY sitting
# here for months would just be a decision nobody made. Add it as <VENDOR>_API_KEY
# alongside LLM_FALLBACK_BASE_URL and LLM_FALLBACK_MODEL when you pick one.
