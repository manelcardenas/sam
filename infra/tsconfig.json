{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "es2020"
    ],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    // Declared by name rather than by directory. The old
    // `typeRoots: ["./node_modules/@types"]` assumed every @types package sat
    // in *this* node_modules — which stopped being true when the repo became
    // an npm workspace and hoisting moved @types/jest to the root. Naming the
    // two globals infra actually needs also keeps the frontend's @types/react
    // and its differently-versioned @types/node out of this project's scope.
    "types": [
      "node",
      "jest"
    ]
  },
  "exclude": [
    "node_modules",
    "cdk.out"
  ]
}
